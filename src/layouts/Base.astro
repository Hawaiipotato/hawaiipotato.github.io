---
import '../styles/site.css';
import ThemeDemo from "../components/ThemeDemo.astro";
import "../styles/themes.css";
import FooterStats from '../components/FooterStats.astro';
import '../styles/migration.css';
import '../styles/main-font.css';
const {home=false,article=false,title="夏威夷土豆",description="记录技术实践、工具折腾和生活随笔。"}=Astro.props;
---
<!doctype html><html lang="zh-CN"><head><script is:inline>try { const saved = localStorage.getItem("demo-mode"); document.documentElement.dataset.mode = saved === "dark" || (saved !== "light" && matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light"; } catch { document.documentElement.dataset.mode = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"; }</script><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{home?"Potato's Blog · 诗酒趁年华":title+" · Potato's Blog"}</title><meta name="google-site-verification" content="wGWTp0WcKiMkfYdMn2EaZuI9xJLL91vDRt-asmIySoY"/><meta property="og:title" content={home?"Potato's Blog · 诗酒趁年华":title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:image" content={new URL('/images/cathead.jpg',Astro.site)}/><meta name="twitter:card" content="summary"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><link rel="icon" href="/favicon.ico"/></head><body><a class="skip-link" href="#main">跳到正文</a><header class="nav"><a class="brand" href="/">Potato&#39;s Blog</a><div class="nav-actions"><button class="menu-toggle" aria-label="菜单" aria-expanded="false" aria-controls="site-nav"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><nav id="site-nav" aria-label="主导航"><a href="/archives/">归档</a><a href="/about/">关于</a><a href="/links/">友链</a></nav><ThemeDemo/></div></header><main id="main"><slot/></main><footer><FooterStats/></footer></body></html>

<script>import "../scripts/site";</script>
