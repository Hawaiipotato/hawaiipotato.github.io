/*! Giscus Light Theme - Potato Blog */
main {
  --color-prettylights-syntax-comment: #6b7280;
  --color-prettylights-syntax-constant: #4A90D9;
  --color-prettylights-syntax-entity: #667eea;
  --color-prettylights-syntax-storage-modifier-import: #1a202c;
  --color-prettylights-syntax-entity-tag: #4A90D9;
  --color-prettylights-syntax-keyword: #667eea;
  --color-prettylights-syntax-string: #0d9488;
  --color-prettylights-syntax-variable: #f59e0b;
  --color-prettylights-syntax-brackethighlighter-unmatched: #ef4444;
  --color-prettylights-syntax-invalid-illegal-text: #1a202c;
  --color-prettylights-syntax-invalid-illegal-bg: #fef2f2;
  --color-prettylights-syntax-carriage-return-text: #1a202c;
  --color-prettylights-syntax-carriage-return-bg: #fee2e2;
  --color-prettylights-syntax-string-regexp: #0d9488;
  --color-prettylights-syntax-markup-list: #f59e0b;
  --color-prettylights-syntax-markup-heading: #4A90D9;
  --color-prettylights-syntax-markup-italic: #1a202c;
  --color-prettylights-syntax-markup-bold: #1a202c;
  --color-prettylights-syntax-markup-deleted-text: #dc2626;
  --color-prettylights-syntax-markup-deleted-bg: #fee2e2;
  --color-prettylights-syntax-markup-inserted-text: #16a34a;
  --color-prettylights-syntax-markup-inserted-bg: #dcfce7;
  --color-prettylights-syntax-markup-changed-text: #d97706;
  --color-prettylights-syntax-markup-changed-bg: #fef3c7;
  --color-prettylights-syntax-markup-ignored-text: #1a202c;
  --color-prettylights-syntax-markup-ignored-bg: #f0f5ff;
  --color-prettylights-syntax-meta-diff-range: #667eea;
  --color-prettylights-syntax-brackethighlighter-angle: #6b7280;
  --color-prettylights-syntax-sublimelinter-gutter-mark: #9ca3af;
  --color-prettylights-syntax-constant-other-reference-link: #4A90D9;
  --color-btn-text: #1a202c;
  --color-btn-bg: #ffffff;
  --color-btn-border: rgba(74,144,217,0.2);
  --color-btn-shadow: 0 0 transparent;
  --color-btn-inset-shadow: 0 0 transparent;
  --color-btn-hover-bg: #f0f5ff;
  --color-btn-hover-border: #4A90D9;
  --color-btn-active-bg: #f0f5ff;
  --color-btn-active-border: #4A90D9;
  --color-btn-selected-bg: #f0f5ff;
  --color-btn-primary-text: #fff;
  --color-btn-primary-bg: #4A90D9;
  --color-btn-primary-border: transparent;
  --color-btn-primary-shadow: 0 0 transparent;
  --color-btn-primary-inset-shadow: 0 0 transparent;
  --color-btn-primary-hover-bg: #667eea;
  --color-btn-primary-hover-border: transparent;
  --color-btn-primary-selected-bg: #4A90D9;
  --color-btn-primary-selected-shadow: 0 0 transparent;
  --color-btn-primary-disabled-text: rgba(26,32,44,0.5);
  --color-btn-primary-disabled-bg: rgba(74,144,217,0.6);
  --color-btn-primary-disabled-border: transparent;
  --color-action-list-item-default-hover-bg: rgba(74,144,217,0.1);
  --color-segmented-control-bg: rgba(74,144,217,0.1);
  --color-segmented-control-button-bg: #ffffff;
  --color-segmented-control-button-selected-border: #4A90D9;
  --color-fg-default: #1a202c;
  --color-fg-muted: #4a5568;
  --color-fg-subtle: #718096;
  --color-canvas-default: rgba(255,255,255,0.85);
  --color-canvas-overlay: #ffffff;
  --color-canvas-inset: #f0f5ff;
  --color-canvas-subtle: #f0f5ff;
  --color-border-default: rgba(74,144,217,0.2);
  --color-border-muted: rgba(74,144,217,0.15);
  --color-neutral-muted: rgba(74,144,217,0.1);
  --color-accent-fg: #4A90D9;
  --color-accent-emphasis: #4A90D9;
  --color-accent-muted: rgba(74,144,217,0.4);
  --color-accent-subtle: rgba(74,144,217,0.1);
  --color-success-fg: #16a34a;
  --color-attention-fg: #d97706;
  --color-attention-muted: rgba(217,119,6,0.4);
  --color-attention-subtle: rgba(217,119,6,0.15);
  --color-danger-fg: #dc2626;
  --color-danger-muted: rgba(220,38,38,0.4);
  --color-danger-subtle: rgba(220,38,38,0.1);
  --color-primer-shadow-inset: 0 0 transparent;
  --color-scale-gray-7: #f0f5ff;
  --color-scale-blue-8: #4A90D9;
  --color-social-reaction-bg-hover: rgba(74,144,217,0.1);
  --color-social-reaction-bg-reacted-hover: rgba(74,144,217,0.2);
}

main .pagination-loader-container {
  background-image: url("https://github.com/images/modules/pulls/progressive-disclosure-line.svg");
}

.gsc-homepage-bg {
  background-color: #f0f5ff;
}

main .gsc-loading-image {
  background-image: url("https://github.githubassets.com/images/mona-loading-default.gif");
}
