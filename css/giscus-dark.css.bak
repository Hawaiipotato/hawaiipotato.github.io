/*! Giscus Dark Theme - Potato Blog */
main {
  --color-prettylights-syntax-comment: #6b7280;
  --color-prettylights-syntax-constant: #00d4ff;
  --color-prettylights-syntax-entity: #b829dd;
  --color-prettylights-syntax-storage-modifier-import: #ffffff;
  --color-prettylights-syntax-entity-tag: #00d4ff;
  --color-prettylights-syntax-keyword: #b829dd;
  --color-prettylights-syntax-string: #8ddb8c;
  --color-prettylights-syntax-variable: #f69d50;
  --color-prettylights-syntax-brackethighlighter-unmatched: #e5534b;
  --color-prettylights-syntax-invalid-illegal-text: #ffffff;
  --color-prettylights-syntax-invalid-illegal-bg: #5c1a1a;
  --color-prettylights-syntax-carriage-return-text: #ffffff;
  --color-prettylights-syntax-carriage-return-bg: #7c1d1d;
  --color-prettylights-syntax-string-regexp: #8ddb8c;
  --color-prettylights-syntax-markup-list: #eac55f;
  --color-prettylights-syntax-markup-heading: #00d4ff;
  --color-prettylights-syntax-markup-italic: #ffffff;
  --color-prettylights-syntax-markup-bold: #ffffff;
  --color-prettylights-syntax-markup-deleted-text: #ffd8d3;
  --color-prettylights-syntax-markup-deleted-bg: #5c1a1a;
  --color-prettylights-syntax-markup-inserted-text: #b4f1b4;
  --color-prettylights-syntax-markup-inserted-bg: #1b4721;
  --color-prettylights-syntax-markup-changed-text: #ffddb0;
  --color-prettylights-syntax-markup-changed-bg: #682d0f;
  --color-prettylights-syntax-markup-ignored-text: #ffffff;
  --color-prettylights-syntax-markup-ignored-bg: #1a1440;
  --color-prettylights-syntax-meta-diff-range: #b829dd;
  --color-prettylights-syntax-brackethighlighter-angle: #6b7280;
  --color-prettylights-syntax-sublimelinter-gutter-mark: #4b5563;
  --color-prettylights-syntax-constant-other-reference-link: #00d4ff;
  --color-btn-text: #ffffff;
  --color-btn-bg: rgba(20,15,40,0.8);
  --color-btn-border: rgba(0,212,255,0.3);
  --color-btn-shadow: 0 0 transparent;
  --color-btn-inset-shadow: 0 0 transparent;
  --color-btn-hover-bg: rgba(30,25,60,0.85);
  --color-btn-hover-border: #00d4ff;
  --color-btn-active-bg: rgba(30,25,60,0.85);
  --color-btn-active-border: #00d4ff;
  --color-btn-selected-bg: rgba(30,25,60,0.85);
  --color-btn-primary-text: #0a0814;
  --color-btn-primary-bg: #00d4ff;
  --color-btn-primary-border: transparent;
  --color-btn-primary-shadow: 0 0 transparent;
  --color-btn-primary-inset-shadow: 0 0 transparent;
  --color-btn-primary-hover-bg: #b829dd;
  --color-btn-primary-hover-border: transparent;
  --color-btn-primary-selected-bg: #00d4ff;
  --color-btn-primary-selected-shadow: 0 0 transparent;
  --color-btn-primary-disabled-text: rgba(255,255,255,0.5);
  --color-btn-primary-disabled-bg: rgba(0,212,255,0.6);
  --color-btn-primary-disabled-border: transparent;
  --color-action-list-item-default-hover-bg: rgba(0,212,255,0.1);
  --color-segmented-control-bg: rgba(0,212,255,0.1);
  --color-segmented-control-button-bg: rgba(20,15,40,0.8);
  --color-segmented-control-button-selected-border: #00d4ff;
  --color-fg-default: #ffffff;
  --color-fg-muted: #a5b4fc;
  --color-fg-subtle: #6b7280;
  --color-canvas-default: rgba(20,15,40,0.8);
  --color-canvas-overlay: #131024;
  --color-canvas-inset: #0a0814;
  --color-canvas-subtle: #131024;
  --color-border-default: rgba(0,212,255,0.3);
  --color-border-muted: rgba(0,212,255,0.2);
  --color-neutral-muted: rgba(0,212,255,0.1);
  --color-accent-fg: #00d4ff;
  --color-accent-emphasis: #00d4ff;
  --color-accent-muted: rgba(0,212,255,0.4);
  --color-accent-subtle: rgba(0,212,255,0.1);
  --color-success-fg: #8ddb8c;
  --color-attention-fg: #eac55f;
  --color-attention-muted: rgba(234,197,95,0.4);
  --color-attention-subtle: rgba(234,197,95,0.15);
  --color-danger-fg: #e5534b;
  --color-danger-muted: rgba(229,83,75,0.4);
  --color-danger-subtle: rgba(229,83,75,0.1);
  --color-primer-shadow-inset: 0 0 transparent;
  --color-scale-gray-7: #131024;
  --color-scale-blue-8: #00d4ff;
  --color-social-reaction-bg-hover: rgba(0,212,255,0.1);
  --color-social-reaction-bg-reacted-hover: rgba(0,212,255,0.2);
}

main .pagination-loader-container {
  background-image: url("https://github.com/images/modules/pulls/progressive-disclosure-line-dark.svg");
}

.gsc-homepage-bg {
  background-color: #0a0814;
}

main .gsc-loading-image {
  background-image: url("https://github.githubassets.com/images/mona-loading-dimmed.gif");
}
